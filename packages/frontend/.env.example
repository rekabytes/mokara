# Origin of the backend, as the Next SERVER reaches it. Runtime, not build-time.
#
# The browser never sees this value: it calls same-origin /api/… and
# app/api/[...path]/route.ts forwards here. That is why there is no
# NEXT_PUBLIC_API_BASE_URL any more — those get inlined into the bundle at build
# time, which would pin a published Docker image to a single host.
#
# Dev (backend on the host):      http://localhost:4700
# Coolify (backend as a service): http://<backend-service>:4700
# No trailing slash, no /api suffix. Required when NODE_ENV=production.
BACKEND_URL=http://localhost:4700
