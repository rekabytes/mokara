DATABASE_URL=postgres://mokara:mokara_password@localhost:5432/mokara?sslmode=disable
PORT=4700

# Only needed when the browser calls this API from another origin. In the
# containerised setup it does not: the frontend proxies /api/* to this service,
# so requests are same-origin and no CORS header is required. Leave empty.
CORS_ALLOWED_ORIGINS=

# Required when ENV=production, at least 32 characters — the backend refuses to
# boot without one, because the fallback below is committed to this repo.
# Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-32-byte-random-string-or-longer

# Session-revocation denylist — logout invalidates the token server-side. The
# default below matches docker-compose's exposed port; point this at your own
# Redis service in a production deployment.
REDIS_URL=redis://localhost:6379

# development | production. production turns on the cookie `Secure` flag and the
# AUTH_SECRET requirement above.
ENV=development

# hosted | self_hosted (PRD-11). self_hosted is the default and means
# "unlimited everything": subscription caps are not enforced and no billing
# surface exists, which is the open-core promise for anyone running these images.
# Set this to hosted only on an instance that charges for plans - or locally, to
# exercise the free-tier caps (3 members, 1 team led).
DEPLOY_MODE=self_hosted

# Object storage for task attachments and workspace logos (PRD-11 Phase 1.3).
# Leave these EMPTY to run without file storage: the app then answers
# `attachments_disabled` on upload and everything else keeps working. That is
# the published image's default, so a self-hoster is never pushed onto someone
# else's bucket.
#
# Any S3-compatible service works — Cloudflare R2 (zero egress fees, the
# reference choice for the hosted instance), MinIO, Backblaze, Spaces. Point
# these at YOUR bucket and the app stores there; nothing proxies through us.
#
# Dev shortcut: `docker compose up minio` brings one up on localhost:9000
# (console on :9001) with the values below.
S3_ENDPOINT=
S3_BUCKET=
# "auto" is Cloudflare's documented value; R2 also accepts a real region string
# like us-east-1 (verified 2026-09-05 against a live bucket). MinIO wants a real
# region, so us-east-1 is the safe value when in doubt.
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1 = bucket-in-the-path addressing, which MinIO and most self-hosted gateways
# require. Verified working for Cloudflare R2 too (2026-09-05: head/put/get/
# delete round-trip with path-style 1), so leave it on unless a gateway insists
# on virtual-host style — then set 0.
S3_FORCE_PATH_STYLE=1

# --- PRD-11 Phase 2: Stripe billing (hosted deployments only) ---------------
# All three unset is the supported default: self-hosted instances never mount
# billing routes, and a hosted deploy without them answers
# `billing_not_configured` — nothing else degrades. Use a RESTRICTED API key
# (Checkout Sessions write, Customers write, Subscriptions/Invoices/Prices/
# Portal read+write — nothing else). The webhook secret comes from the
# Dashboard/CLI webhook endpoint that receives:
# checkout.session.completed, customer.subscription.created/updated/deleted,
# invoice.paid, invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Starter monthly USD price id (price_…). The tier→price mapping by
# lookup_key lives in lib/plans.ts; rotating the id is an env change.
STRIPE_PRICE_STARTER=
