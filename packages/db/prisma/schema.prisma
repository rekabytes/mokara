model WorkspaceFile {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid
  folderId String? @map("folder_id") @db.Uuid
  name String
  uploadedById String? @map("uploaded_by_id") @db.Uuid
  uploaderName String @map("uploader_name")
  sizeBytes Int @map("size_bytes")
  contentType String @map("content_type")
  contentHash String @map("content_hash")
  uploadId String @unique @map("upload_id") @db.Uuid
  storageKey String @unique @map("storage_key")
  trashedAt DateTime? @map("trashed_at") @db.Timestamptz(3)
  trashBatchId String? @map("trash_batch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
