generator client {
  provider            = "prisma-client"
  output              = "./generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  displayName  String?  @map("display_name")
  // PRD-11: subscription tier (free | starter | pro | ultra). Lives on the
  // user, not the team — a workspace's tier is its leader's plan. Plain String
  // + DB CHECK like kind/status. Writers: the Phase 2 webhook/sync mapping
  // (lib/billing.ts) and the operator console's override (routes/admin.ts),
  // which is the comp/grant path and logs every change.
  plan         String   @default("free")
  // Operator grants (2026-09-09): `plan` above is Stripe's opinion and only
  // lib/billing.ts writes it. This column is the console's grant and it WINS at
  // read time — every tier read goes through effectivePlan() in lib/plans.ts.
  // NULL for almost everyone; applying a real paid subscription clears it, so
  // money stays the source of truth. Two writers, two columns, no reconciliation.
  planOverride   String?  @map("plan_override")
  // Owner (2026-09-06): last container the user selected — server-side UI
  // state so a refresh restores "where you work" without device storage
  // (cookie policy: no localStorage). GET /teams filters it against live
  // membership; the FK clears it when the container is deleted.
  lastContainerId String? @map("last_container_id") @db.Uuid
  // PRD-11 Phase 2: Stripe billing linkage, maintained ONLY by the webhook
  // (+ the sync endpoint running the same mapping). All nullable: free and
  // self-hosted accounts have none. grace_until = paid features still on
  // while a failed payment recovers; period_end = current paid period.
  stripeCustomerId String?   @map("stripe_customer_id")
  graceUntil       DateTime?  @map("grace_until") @db.Timestamptz(3)
  periodEnd        DateTime?  @map("period_end") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownedTeams        Team[]           @relation("TeamOwner")
  memberships       TeamMember[]
  invitationsSent   TeamInvitation[] @relation("Inviter")
  invitationsTarget TeamInvitation[] @relation("Invitee")
  comments          Comment[]
  taskEvents        TaskEvent[]      @relation("TaskEventActor")
  taskDueChanges    TaskDueChange[]  @relation("TaskDueChangeActor")
  projects          Project[]        @relation("ProjectOwner")
  kpis              Kpi[]            @relation("KpiOwner")
  notifications     Notification[]
  createdTasks      Task[]           @relation("TaskCreator")
  assignedTasks     Task[]           @relation("TaskAssignee")
  attachments       Attachment[]
  lastContainer     Team?            @relation("LastContainer", fields: [lastContainerId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Team {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id") @db.Uuid
  kind      String   @default("team") // "workspace" (private, solo) | "team"
  // PRD-11 Phase 1.4: the container's logo. All three stay null together — a
  // workspace either has one or does not — and the bytes count against the same
  // storage quota as attachments (see lib/quota.ts).
  logoKey   String?  @map("logo_key")
  logoBytes Int?     @map("logo_bytes")
  logoType  String?  @map("logo_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner       User             @relation("TeamOwner", fields: [ownerId], references: [id])
  lastSelectedBy User[]        @relation("LastContainer")
  members     TeamMember[]
  invitations TeamInvitation[]
  tasks       Task[]
  taskEvents  TaskEvent[]
  projects    Project[]
  kpis        Kpi[]
  attachments Attachment[]

  @@map("teams")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvitation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String    @map("team_id") @db.Uuid
  inviterId       String    @map("inviter_id") @db.Uuid
  inviteeUsername String    @map("invitee_username") @db.Citext
  status          String    @default("pending")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime  @default(dbgenerated("(now() + interval '7 days')")) @map("expires_at") @db.Timestamptz(3)
  respondedAt     DateTime? @map("responded_at") @db.Timestamptz(3)

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter User @relation("Inviter", fields: [inviterId], references: [id])
  invitee User @relation("Invitee", fields: [inviteeUsername], references: [username])

  @@index([teamId])
  @@index([inviteeUsername, status])
  @@map("team_invitations")
}

model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  projectId   String?   @map("project_id") @db.Uuid
  title       String
  description String?
  status      String    @default("todo")
  priority    String    @default("medium")
  dueDate     DateTime? @map("due_date") @db.Timestamptz(3)
  flagged     Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  // PRD-10: the owner is the immutable creator (null for tasks predating the
  // column); the assignee is mutable and always a member of the same team —
  // both nullable, users leaving (future account deletion) nulls them.
  creatorId   String?   @map("creator_id") @db.Uuid
  assigneeId  String?   @map("assignee_id") @db.Uuid

  team       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator    User?           @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  assignee   User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments   Comment[]
  events     TaskEvent[]
  dueChanges TaskDueChange[]
  kpiBindings TaskKpi[]
  subtaskItems SubtaskItem[]
  attachments Attachment[]

  @@index([teamId, status])
  @@index([status])
  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

// PRD-11 Phase 1.2: a checklist inside a task. Deliberately flat items rather
// than child tasks — no recursion, no per-item assignee or due date; those
// would each drag the whole task surface into the model. Order is client-drawn
// and stored in `position`.
model SubtaskItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  title     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
  @@map("subtask_items")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
  attachments Attachment[]

  @@index([taskId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model TaskEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  team  Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation("TaskEventActor", fields: [actorId], references: [id])

  @@index([teamId, createdAt])
  @@index([taskId])
  @@map("task_events")
}

// Due-date history: one row per actual due_date edit, so progress
// analytics can show "extra time was added" (deadline revisions).
model TaskDueChange {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  fromDue   DateTime? @map("from_due") @db.Timestamptz(3)
  toDue     DateTime? @map("to_due") @db.Timestamptz(3)
  actorId   String    @map("actor_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation("TaskDueChangeActor", fields: [actorId], references: [id])

  @@index([taskId, createdAt])
  @@map("task_due_changes")
}

// PRD-06: Projects group tasks; scope "team" (owner-created, shared) or
// "personal" (any member, visible to the team). No linking between them.
model Project {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  scope     String   @default("personal") // "team" | "personal"
  name      String
  color     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  team  Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner User   @relation("ProjectOwner", fields: [ownerId], references: [id])
  tasks Task[]

  @@index([teamId, scope])
  @@map("projects")
}

// KPIs are measured via weighted task bindings (TaskKpi), progress =
// Σ(weight × status fraction) ÷ Σ(weight) — see routes/kpis.ts.
model Kpi {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner    User      @relation("KpiOwner", fields: [ownerId], references: [id])
  bindings TaskKpi[]

  @@index([teamId])
  @@map("kpis")
}

model TaskKpi {
  taskId String @map("task_id") @db.Uuid
  kpiId  String @map("kpi_id") @db.Uuid
  weight Int    // percent 1–100; per-task total ≤ 100 enforced in the route

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kpi  Kpi  @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@id([taskId, kpiId])
  @@index([kpiId])
  @@map("task_kpis")
}

// PRD-11 Phase 1.3: a file on a task. team_id is denormalised because the
// storage quota is summed per workspace on every upload — see the migration.
// The bytes live in object storage under storage_key, which the server mints
// from this row's id; the filename never touches the key.
// PRD-11 Phase 1.3: a file on a task — or, since comment attachments, on a
// comment. team_id is denormalised because the storage quota is summed per
// workspace on every upload — see the migration. The bytes live in object
// storage under storage_key, which the server mints from this row's id; the
// filename never touches the key. Exactly one of task_id / comment_id is set
// (attachments_owner_check).
model Attachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId      String?  @map("task_id") @db.Uuid
  commentId   String?  @map("comment_id") @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  uploaderId  String   @map("uploader_id") @db.Uuid
  filename    String
  sizeBytes   Int      @map("size_bytes")
  contentType String   @map("content_type")
  storageKey  String   @unique @map("storage_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task     Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment  Comment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  team     Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  uploader User       @relation(fields: [uploaderId], references: [id])

  @@index([taskId])
  @@index([commentId])
  @@index([teamId])
  @@map("attachments")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // "invitation" | "invitation_accepted" | "comment_reply" — a string, not an
  // enum, so the UI can grow types (due-date reminders, mentions) without a
  // migration. The payload carries whatever the row needs to render + link.
  type      String
  payload   Json
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}
