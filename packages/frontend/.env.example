# Origin of the backend, as the Next SERVER reaches it. Runtime, not build-time.
#
# The browser never sees this value: it calls same-origin /api/… and
# app/api/[...path]/route.ts forwards here. That is why there is no
# NEXT_PUBLIC_API_BASE_URL any more — those get inlined into the bundle at build
# time, which would pin a published Docker image to a single host.
#
# Dev (backend on the host):      http://localhost:4700
# Coolify (backend as a service): http://<backend-service>:4700
# No trailing slash, no /api suffix. Required when NODE_ENV=production.
BACKEND_URL=http://localhost:4700

# Public origin of the frontend, with no trailing slash. Also used by the legal
# documents as the named Service, so leave it unset on a private instance and
# those pages will show "not configured" instead of a wrong URL.
#
# Read SERVER-side only — root layout's `metadataBase` (so og:url and og:image
# resolve to absolute URLs) and lib/legal.ts. Nothing client-side references it,
# so unlike a build-time NEXT_PUBLIC_ value this does work as a runtime variable
# on Coolify; a published image stays host-agnostic.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Operator identity — required only if you publish the legal documents
# (/terms-of-use, /privacy-policy, /cookie-policy) for an instance you run.
#
# These are deliberately NOT in source: who operates a deployment is a fact about
# the deployment. And they are deliberately NOT `NEXT_PUBLIC_*`, because Next
# inlines a prefixed var into the client bundle — none of these belong there. Every
# consumer is a server component (lib/legal.ts, components/LegalDoc.tsx).
#
# Anything unset renders as a visible "not configured" chip on those pages rather
# than a blank or an invented value, so a half-configured install cannot quietly
# ship someone else's policy.
#
# The document TEXT (statutes, liability cap, governing law) is Malaysian-shaped
# and lives in the .tsx files — rewrite it for your own jurisdiction.
# ---------------------------------------------------------------------------

# Legal name of the entity that is the data controller / contracting party.
LEG_OPERATOR_NAME=
# Business or company registration number, quoted in the PDPA-style notice.
LEG_OPERATOR_REGISTRATION=
# Optional one-line description of the legal form, e.g. "a business registered in
# Malaysia under the Registration of Businesses Act 1956, which is not a separate
# legal person". The row is omitted when blank.
LEG_OPERATOR_ENTITY_NOTE=
# Where the operator is based; drives the footer's "Made in …" line only.
LEG_OPERATOR_COUNTRY=

# One inbox for data requests, support, abuse and security reports. Without it the
# contact blocks and the footer show a chip instead of an address.
LEG_CONTACT_EMAIL=
# Correspondence address. Leave blank to publish the "address not published, but
# supplied on request to a data subject, the Commissioner or a court" statement —
# which is enough for the PDPA's notice duty (contact details, not a street
# address) and for GDPR's "identity and contact details".
LEG_POSTAL_ADDRESS=

# Where the hosted database physically runs (e.g. "Malaysia (Kuala Lumpur)" or
# "ap-southeast-1"). Feeds the cross-border-transfer section; unset shows a chip.
LEG_HOSTING_REGION=
# How long database backups and platform logs are kept, e.g. "7 days nightly".
# Caps how fast deletion is final; unset shows a chip.
LEG_BACKUP_RETENTION=
