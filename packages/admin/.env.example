# Operator console (packages/admin) — the env contract; src/env.ts enforces it.
#
# This service holds NO DATABASE_URL and NO Stripe key on purpose: every read and
# write is proxied to the backend's /api/admin routes, so a compromised console
# can only ask for what that API serves — it cannot read the product database
# directly or touch the payment processor.
#
# ADMIN_TOKEN_SECRET and ADMIN_URL_KEY MUST equal the backend's values:
#
#   ADMIN_TOKEN_SECRET — the backend signs the console's 8h token with it, and
#     this app verifies that same token with its own copy before it serves a
#     page or proxies a call. A mismatch is not silent: login answers 502 with a
#     message naming this variable.
#   ADMIN_URL_KEY — the secret the login URL must carry (/login?key=…). Without a
#     match the form is never rendered and the POST answers a plain 404, so a
#     scanner that finds /login cannot even try a password. The backend checks
#     the same key again in the login body.
#
# Both empty is the supported default: the console answers 404 everywhere and the
# login page does not exist.

# Internal address of the mokara backend (backend :4700, frontend :4701, this
# service :4702). Never exposed to the browser — the console proxies every call.
BACKEND_URL=http://127.0.0.1:4700

# This service's own port.
ADMIN_PORT=4702

# development | production. production turns on the `__Host-` cookie prefix, the
# cookie `Secure` flag, and the boot-time minimum lengths for the two secrets
# below (32+ and 16+ characters) — a production console with a guessable signing
# key is a failed deploy, not a warning.
ENV=development

# Generate: openssl rand -base64 48 — and put the SAME value in the backend .env.
ADMIN_TOKEN_SECRET=

# Generate: openssl rand -hex 16 — and put the SAME value in the backend .env.
ADMIN_URL_KEY=
