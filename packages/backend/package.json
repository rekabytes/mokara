{
  "name": "@mokara/backend",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @mokara/db bootstrap",
    "dev": "tsx watch --exclude \"**/prisma/generated/**\" src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:github": "node --import tsx --experimental-test-module-mocks --test test/github-sync.test.mjs",
    "test:auth": "node --import tsx --experimental-test-module-mocks --test test/auth-protection.test.mjs test/social-auth.test.mjs test/social-routes.test.mjs",
    "test:admin": "node --import tsx --experimental-test-module-mocks --test test/admin-monitoring.test.mjs test/billing-monitoring.test.mjs",
    "test:mcp": "node --import tsx --experimental-test-module-mocks --test test/mcp.test.mjs test/mcp-oauth.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mokara/db": "workspace:*",
    "@mokara/redis": "workspace:*",
    "@node-oauth/oauth2-server": "^5.3.0",
    "@prisma/adapter-pg": "^7.9.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "hono": "^4.12.0",
    "jose": "^5.9.6",
    "stripe": "^22.6.1",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
