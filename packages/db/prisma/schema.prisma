  unit           String?
  baseline       Decimal              @db.Decimal(20, 4)
  target         Decimal              @db.Decimal(20, 4)
  currentValue   Decimal?             @map("current_value") @db.Decimal(20, 4)
  startDate      DateTime             @map("start_date") @db.Date
  endDate        DateTime             @map("end_date") @db.Date
