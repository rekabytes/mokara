{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Source imports carry `.ts` extensions, same posture as the backend and
    // db packages: tsc is the type gate only, `tsx` runs the source (see the
    // backend tsconfig for the full reasoning).
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
