  @@index([supportTicketId])
}

// Durable cleanup survives removal of file metadata (and of its workspace).
// Queued bytes remain charged until object deletion succeeds.
model FileObjectDeletion {
  uploadId String? @unique @map("upload_id") @db.Uuid
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  storageKey String @unique @map("storage_key")
  sizeBytes Int @map("size_bytes")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([nextAttemptAt])
  @@index([ownerId])
  @@index([teamId])
  @@map("file_object_deletions")
}


