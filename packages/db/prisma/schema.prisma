generator client {
  provider            = "prisma-client"
  output              = "./generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username         String    @unique @db.Citext
  usernameClaimed  Boolean   @default(true) @map("username_claimed")
  passwordHash     String?   @map("password_hash")
  displayName      String?   @map("display_name")
  // PRD-11: subscription tier (free | starter | pro | ultra). Lives on the
  // user, not the team — a workspace's tier is its leader's plan. Plain String
  // + DB CHECK like kind/status. Writers: the Phase 2 webhook/sync mapping
  // (lib/billing.ts) and the operator console's override (routes/admin.ts),
  // which is the comp/grant path and logs every change.
  plan             String    @default("free")
  // Existing accounts retain per-workspace capacity until a new paid purchase.
  peoplePolicy     String    @default("account") @map("people_policy")
  // Operator grants (2026-09-09): `plan` above is Stripe's opinion and only
  // lib/billing.ts writes it. This column is the console's grant and it WINS at
  // read time — every tier read goes through effectivePlan() in lib/plans.ts.
  // NULL for almost everyone; applying a real paid subscription clears it, so
  // money stays the source of truth. Two writers, two columns, no reconciliation.
  planOverride     String?   @map("plan_override")
  // Owner (2026-09-06): last container the user selected — server-side UI
  // state so a refresh restores "where you work" without device storage
  // (cookie policy: no localStorage). GET /teams filters it against live
  // membership; the FK clears it when the container is deleted.
  lastContainerId  String?   @map("last_container_id") @db.Uuid
  // PRD-13: first-run spotlight tour. NULL = never resolved, so the tour runs —
  // a fresh account, an account that predates the column, or one abandoned
  // mid-tour. 'completed' (reached the last step) and 'skipped' (Skip / close /
  // Esc) both mean never show it again. Exactly one writer: PATCH
  // /me/onboarding. tourResolvedAt is bookkeeping — no visibility rule reads it.
  tourState        String?   @map("tour_state")
  tourResolvedAt   DateTime? @map("tour_resolved_at") @db.Timestamptz(3)
  // PRD-11 Phase 2: Stripe billing linkage, maintained ONLY by the webhook
  // (+ the sync endpoint running the same mapping). All nullable: free and
  // self-hosted accounts have none. grace_until = paid features still on
  // while a failed payment recovers; period_end = current paid period.
  billingStatus String? @map("billing_status")
  billingCancelAtPeriodEnd Boolean? @map("billing_cancel_at_period_end")
  billingCancelAt DateTime? @map("billing_cancel_at") @db.Timestamptz(3)
  billingVerifiedAt DateTime? @map("billing_verified_at") @db.Timestamptz(3)
  billingAttemptedAt DateTime? @map("billing_attempted_at") @db.Timestamptz(3)
  billingErrorCode String? @map("billing_error_code")
  billingInvoiceStatus String? @map("billing_invoice_status")
  billingInvoiceObservedAt DateTime? @map("billing_invoice_observed_at") @db.Timestamptz(3)
  billingReconciliations BillingReconciliationEvent[]
  stripeCustomerId String?   @map("stripe_customer_id")
  graceUntil       DateTime? @map("grace_until") @db.Timestamptz(3)
  periodEnd        DateTime? @map("period_end") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  businessKpisOwned KpiGoal[] @relation("KpiGoalOwner")
  businessKpisCreated KpiGoal[] @relation("KpiGoalCreator")
  businessKpiEntries KpiGoalEntry[]
  ownedTeams        Team[]                   @relation("TeamOwner")
  memberships       TeamMember[]
  invitationsSent   TeamInvitation[]         @relation("Inviter")
  invitationsTarget TeamInvitation[]         @relation("Invitee")
  comments          Comment[]
  taskEvents        TaskEvent[]              @relation("TaskEventActor")
  taskDueChanges    TaskDueChange[]          @relation("TaskDueChangeActor")
  projects          Project[]                @relation("ProjectOwner")
  kpis              Kpi[]                    @relation("KpiOwner")
  notifications     Notification[]
  createdTasks      Task[]                   @relation("TaskCreator")
  assignedTasks     Task[]                   @relation("TaskAssignee")
  workspaceFolders WorkspaceFolder[] @relation("WorkspaceFolderCreator")
  workspaceFiles WorkspaceFile[] @relation("WorkspaceFileUploader")
  supportAssignments SupportTicket[] @relation("SupportAssignee")
  attachments       Attachment[]
  adminAuditEvents  AdminAuditEvent[]
  githubConnection  GitHubAccountConnection?
  authIdentities    AuthIdentity[]
  mcpConnections    McpConnection[]
  githubIssueLinks  GitHubIssueLink[]        @relation("GitHubIssueCreator")
  lastContainer     Team?                    @relation("LastContainer", fields: [lastContainerId], references: [id], onDelete: SetNull)

  @@map("users")
}

// Login identities are separate from repository integration permissions.
// Email is a verified provider snapshot, never an account-merge key.
model AuthIdentity {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  provider String
  subject String
  email String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, subject])
  @@unique([userId, provider])
  @@map("auth_identities")
}

// Classified provider reconciliation outcomes, never raw provider payloads.
model BillingReconciliationEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String? @map("user_id") @db.Uuid
  source String
  outcome String
  errorCode String? @map("error_code")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([createdAt, id])
  @@index([userId])
  @@map("billing_reconciliation_events")
}

// Durable operator-account audit; a deleted target keeps its username snapshot.
model AdminAuditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor          String
  action         String
  targetUserId   String?  @map("target_user_id") @db.Uuid
  targetUsername String   @map("target_username")
  fromPlan       String?  @map("from_plan")
  toPlan         String?  @map("to_plan")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  targetUser     User?    @relation(fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt, id])
  @@index([targetUserId])
  @@map("admin_audit_events")
}

model Team {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id") @db.Uuid
  kind      String   @default("team") // "workspace" (private, solo) | "team"
  // PRD-11 Phase 1.4: the container's logo. All three stay null together — a
  // workspace either has one or does not — and the bytes count against the same
  // storage quota as attachments (see lib/quota.ts).
  logoKey   String?  @map("logo_key")
  logoBytes Int?     @map("logo_bytes")
  logoType  String?  @map("logo_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner          User             @relation("TeamOwner", fields: [ownerId], references: [id])
  lastSelectedBy User[]           @relation("LastContainer")
  members        TeamMember[]
  invitations    TeamInvitation[]
  tasks          Task[]
  taskEvents     TaskEvent[]
  projects       Project[]
  kpis           Kpi[]
  kpiGoals KpiGoal[]
  workspaceFolders WorkspaceFolder[]
  workspaceFiles WorkspaceFile[]
  attachments    Attachment[]
  supportSites SupportSite[]
  supportTickets SupportTicket[]

  @@map("teams")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  kpiContributions KpiGoalContributor[]

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvitation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String    @map("team_id") @db.Uuid
  inviterId       String    @map("inviter_id") @db.Uuid
  inviteeUsername String    @map("invitee_username") @db.Citext
  status          String    @default("pending")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime  @default(dbgenerated("(now() + interval '7 days')")) @map("expires_at") @db.Timestamptz(3)
  respondedAt     DateTime? @map("responded_at") @db.Timestamptz(3)

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter User @relation("Inviter", fields: [inviterId], references: [id])
  invitee User @relation("Invitee", fields: [inviteeUsername], references: [username])

  @@index([teamId])
  @@index([inviteeUsername, status])
  @@map("team_invitations")
}

model Task {
  agentReady           Boolean @default(false) @map("agent_ready")
  agentSyncPaused      Boolean @default(false) @map("agent_sync_paused")
  agentRevision        BigInt  @default(1) @map("agent_revision")
  agentContentRevision BigInt  @default(1) @map("agent_content_revision")
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  projectId   String?   @map("project_id") @db.Uuid
  title       String
  description String?
  status      String    @default("todo")
  priority    String    @default("medium")
  dueDate     DateTime? @map("due_date") @db.Timestamptz(3)
  flagged     Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  // PRD-10: the owner is the immutable creator (null for tasks predating the
  // column); the assignee is mutable and always a member of the same team —
  // both nullable, users leaving (future account deletion) nulls them.
  creatorId   String?   @map("creator_id") @db.Uuid
  assigneeId  String?   @map("assignee_id") @db.Uuid

  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator         User?            @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  assignee        User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments        Comment[]
  events          TaskEvent[]
  dueChanges      TaskDueChange[]
  kpiBindings     TaskKpi[]
  subtaskItems    SubtaskItem[]
  attachments     Attachment[]
  githubIssueLink GitHubIssueLink?

  @@index([teamId, status])
  @@index([teamId, createdAt, id])
  @@index([status])
  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
  supportTicket SupportTicket?
}

// PRD-11 Phase 1.2: a checklist inside a task. Deliberately flat items rather
// than child tasks — no recursion, no per-item assignee or due date; those
// would each drag the whole task surface into the model. Order is client-drawn
// and stored in `position`.
// GitHub App integration: identity is user-scoped, while installations are
// normalized because several connected users may access the same organization
// installation. Renewable user credentials are authenticated ciphertext only.
model GitHubAccountConnection {
  verificationRetryAt DateTime? @map("verification_retry_at") @db.Timestamptz(3)
  credentialsEncrypted String? @map("credentials_encrypted")
  refreshLeaseId String? @map("refresh_lease_id") @db.Uuid
  refreshLeaseUntil DateTime? @map("refresh_lease_until") @db.Timestamptz(3)
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  githubUserId BigInt   @map("github_user_id")
  githubLogin  String   @map("github_login")
  status       String   @default("active")
  verifiedAt   DateTime @map("verified_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  installations GitHubAccountInstallation[]
  repositories  GitHubAccountRepository[]
  issueLinks    GitHubIssueLink[]

  @@index([status, verifiedAt])
  @@map("github_account_connections")
}

model GitHubInstallation {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  githubInstallationId BigInt   @unique @map("github_installation_id")
  accountId            BigInt   @map("account_id")
  accountLogin         String   @map("account_login")
  accountType          String   @map("account_type")
  status               String   @default("active")
  lastVerifiedAt       DateTime @map("last_verified_at") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  connections  GitHubAccountInstallation[]
  repositories GitHubRepository[]

  @@map("github_installations")
}

model GitHubAccountInstallation {
  connectionId   String   @map("connection_id") @db.Uuid
  installationId String   @map("installation_id") @db.Uuid
  verifiedAt     DateTime @map("verified_at") @db.Timestamptz(3)

  connection   GitHubAccountConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  installation GitHubInstallation      @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@id([connectionId, installationId])
  @@index([installationId])
  @@map("github_account_installations")
}

model GitHubRepository {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  installationId     String   @map("installation_id") @db.Uuid
  githubRepositoryId BigInt   @unique @map("github_repository_id")
  ownerLogin         String   @map("owner_login")
  name               String
  fullName           String   @map("full_name")
  private            Boolean  @default(false)
  active             Boolean  @default(true)
  lastVerifiedAt     DateTime @map("last_verified_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  installation GitHubInstallation        @relation(fields: [installationId], references: [id], onDelete: Cascade)
  connections  GitHubAccountRepository[]
  issueLinks   GitHubIssueLink[]

  @@unique([installationId, githubRepositoryId])
  @@index([installationId, active])
  @@map("github_repositories")
}

model GitHubAccountRepository {
  connectionId String   @map("connection_id") @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  verifiedAt   DateTime @map("verified_at") @db.Timestamptz(3)
  enabled      Boolean  @default(false)

  connection GitHubAccountConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  repository GitHubRepository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([connectionId, repositoryId])
  @@index([repositoryId])
  @@map("github_account_repositories")
}

model GitHubIssueLink {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId             String                  @unique @map("task_id") @db.Uuid
  repositoryId       String                  @map("repository_id") @db.Uuid
  createdByUserId    String?                 @map("created_by_user_id") @db.Uuid
  connectionId       String?                 @map("connection_id") @db.Uuid
  githubIssueId      BigInt?                 @map("github_issue_id")
  issueNumber        Int?                    @map("issue_number")
  issueUrl           String?                 @map("issue_url")
  repositoryFullName String                  @map("repository_full_name")
  status             String                  @default("creating")
  attemptCount       Int                     @default(1) @map("attempt_count")
  lastErrorCode      String?                 @map("last_error_code")
  lastAttemptAt      DateTime                @default(now()) @map("last_attempt_at") @db.Timestamptz(3)
  linkedAt           DateTime?               @map("linked_at") @db.Timestamptz(3)
  syncStatus         String                  @default("idle") @map("sync_status")
  syncErrorCode      String?                 @map("sync_error_code")
  issueState         String?                 @map("issue_state")
  lastSyncedAt       DateTime?               @map("last_synced_at") @db.Timestamptz(3)
  githubUpdatedAt    DateTime?               @map("github_updated_at") @db.Timestamptz(3)
  localStatusAt      DateTime?               @map("local_status_at") @db.Timestamptz(3)
  syncRevision       Int                     @default(0) @map("sync_revision")
  desiredState       String?                 @map("desired_state")
  pullRequests       GitHubPullRequestLink[]
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  task          Task                     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repository    GitHubRepository         @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  createdByUser User?                    @relation("GitHubIssueCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  connection    GitHubAccountConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([repositoryId])
  @@index([createdByUserId])
  @@index([repositoryId, githubIssueId])
  @@map("github_issue_links")
}

model GitHubPullRequestLink {
  issueLinkId   String          @map("issue_link_id") @db.Uuid
  pullRequestId BigInt          @map("pull_request_id")
  updatedAt     DateTime        @map("updated_at") @db.Timestamptz(3)
  issueLink     GitHubIssueLink @relation(fields: [issueLinkId], references: [id], onDelete: Cascade)

  @@id([issueLinkId, pullRequestId])
  @@index([pullRequestId])
  @@map("github_pull_request_links")
}

// Durable inbound webhook inbox and outbound status outbox. No credentials or
// entire webhook bodies are stored: payloads contain only validated coordinates.
model GitHubSyncJob {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          String
  deliveryId    String?   @unique @map("delivery_id")
  payload       Json
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  leaseToken    String?   @map("lease_token") @db.Uuid
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(3)
  lastErrorCode String?   @map("last_error_code")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([completedAt, availableAt])
  @@map("github_sync_jobs")
}

model SubtaskItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  title     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
  @@map("subtask_items")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  parent      Comment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]    @relation("CommentReplies")
  attachments Attachment[]

  @@index([taskId, createdAt])
  @@index([taskId, createdAt, id])
  @@index([parentId])
  @@map("comments")
}

model TaskEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  source      String   @default("mokara")
  githubLogin String?  @map("github_login")
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation("TaskEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([teamId, createdAt])
  @@index([taskId])
  @@map("task_events")
}

// Due-date history: one row per actual due_date edit, so progress
// analytics can show "extra time was added" (deadline revisions).
model TaskDueChange {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  fromDue   DateTime? @map("from_due") @db.Timestamptz(3)
  toDue     DateTime? @map("to_due") @db.Timestamptz(3)
  actorId   String    @map("actor_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation("TaskDueChangeActor", fields: [actorId], references: [id])

  @@index([taskId, createdAt])
  @@map("task_due_changes")
}

// PRD-06: Projects group tasks; scope "team" (owner-created, shared) or
// "personal" (any member, visible to the team). No linking between them.
model Project {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  scope     String   @default("personal") // "team" | "personal"
  name      String
  color     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  team  Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner User   @relation("ProjectOwner", fields: [ownerId], references: [id])
  tasks Task[]

  @@index([teamId, scope])
  @@map("projects")
}

// KPIs are measured via weighted task bindings (TaskKpi), progress =
// Σ(weight × status fraction) ÷ Σ(weight) — see routes/kpis.ts.
model Kpi {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner    User      @relation("KpiOwner", fields: [ownerId], references: [id])
  bindings TaskKpi[]

  @@index([teamId])
  @@map("kpis")
}

model TaskKpi {
  taskId String @map("task_id") @db.Uuid
  kpiId  String @map("kpi_id") @db.Uuid
  weight Int // percent 1–100; per-task total ≤ 100 enforced in the route

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kpi  Kpi  @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@id([taskId, kpiId])
  @@index([kpiId])
  @@map("task_kpis")
}

// PRD-11 Phase 1.3: a file on a task. team_id is denormalised because the
// storage quota is summed per workspace on every upload — see the migration.
// The bytes live in object storage under storage_key, which the server mints
// from this row's id; the filename never touches the key.
// PRD-11 Phase 1.3: a file on a task — or, since comment attachments, on a
// comment. team_id is denormalised because the storage quota is summed per
// workspace on every upload — see the migration. The bytes live in object
// storage under storage_key, which the server mints from this row's id; the
// filename never touches the key. Exactly one of task_id / comment_id is set
// (attachments_owner_check).
model Attachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId      String?  @map("task_id") @db.Uuid
  commentId   String?  @map("comment_id") @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  uploaderId  String   @map("uploader_id") @db.Uuid
  filename    String
  sizeBytes   Int      @map("size_bytes")
  contentType String   @map("content_type")
  storageKey  String   @unique @map("storage_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task     Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id])

  @@index([taskId])
  @@index([commentId])
  @@index([teamId])
  @@map("attachments")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // "invitation" | "invitation_accepted" | "comment_reply" — a string, not an
  // enum, so the UI can grow types (due-date reminders, mentions) without a
  // migration. The payload carries whatever the row needs to render + link.
  type      String
  payload   Json
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// Opaque, hashed, read-only pilot credentials. Workspace IDs are an allow-list;
// current membership is independently checked on every tool invocation.
model McpConnection {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  name         String
  tokenHash    String?   @unique @map("token_hash")
  clientId     String?   @map("client_id") @db.Uuid
  resource     String?
  workspaceIds String[]  @map("workspace_ids") @db.Uuid
  scopes String[] @default(["mokara:read"])
  repositoryIds String[] @default([]) @map("repository_ids") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  client McpOAuthClient? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  codes  McpOAuthCode[]
  tokens McpOAuthToken[]

  operations McpOperation[]

  @@index([userId, createdAt])
  @@map("mcp_connections")
}

model McpOAuthClient {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  redirectUris String[]        @map("redirect_uris")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  connections  McpConnection[]

  @@map("mcp_oauth_clients")
}

model McpOAuthCode {
  codeHash     String        @id @map("code_hash")
  connectionId String        @map("connection_id") @db.Uuid
  redirectUri  String        @map("redirect_uri")
  challenge    String
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime?     @map("consumed_at") @db.Timestamptz(3)
  connection   McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("mcp_oauth_codes")
}

model McpOAuthToken {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId     String        @map("connection_id") @db.Uuid
  accessHash       String        @unique @map("access_hash")
  refreshHash      String        @unique @map("refresh_hash")
  accessExpiresAt  DateTime      @map("access_expires_at") @db.Timestamptz(3)
  refreshExpiresAt DateTime      @map("refresh_expires_at") @db.Timestamptz(3)
  scopes String[] @default(["mokara:read"])
  refreshUsedAt    DateTime?     @map("refresh_used_at") @db.Timestamptz(3)
  connection       McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("mcp_oauth_tokens")
}

model McpOperation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId String @map("connection_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  operation String
  requestHash String @map("request_hash")
  status String @default("pending")
  result Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  connection McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@unique([connectionId, requestId])
  @@index([userId, createdAt])
  @@map("mcp_operations")
}


model WorkspaceFolder {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  name String
  createdById String? @map("created_by_id") @db.Uuid
  creatorName String @map("creator_name")
  trashedAt DateTime? @map("trashed_at") @db.Timestamptz(3)
  trashBatchId String? @map("trash_batch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator User? @relation("WorkspaceFolderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  parent WorkspaceFolder? @relation("WorkspaceFolderTree", fields: [parentId, teamId], references: [id, teamId], onDelete: Cascade)
